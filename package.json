{
  "name": "dsh-continue-all",
  "version": "0.1.1",
  "description": "DSH Web UI plugin: continues every session whose turn was left open by an unexpected DSH exit.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mkpoli/dsh-continue-all.git"
  },
  "homepage": "https://github.com/mkpoli/dsh-continue-all",
  "bugs": {
    "url": "https://github.com/mkpoli/dsh-continue-all/issues"
  },
  "author": "mkpoli",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "continue",
    "web-ui"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
